CONFIG_IDF_TARGET_ESP32P4=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FLASH_LOAD_TO_PSRAM=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_LV_MEM_SIZE_KILOBYTES=192
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
CONFIG_BSP_LCD_USE_DMA2D=y
CONFIG_BSP_LCD_TYPE_1024_600=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

# On-board ESP32-C6 Wi-Fi co-processor over ESP-Hosted SDIO.
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=32
CONFIG_TUCO_C6_WIFI_SSID="Redmi K70"
CONFIG_TUCO_C6_WIFI_PASSWORD="21sk21sk"

# Minimal embedded ESP-Claw Agent Loop. The DeepSeek API key stays only in
# the local sdkconfig.
CONFIG_TUCO_AGENT_ENABLED=y
CONFIG_TUCO_AGENT_DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
CONFIG_TUCO_AGENT_MODEL="deepseek-v4-flash"
CONFIG_TUCO_AGENT_MAX_TOKENS=160
CONFIG_TUCO_AGENT_SERIAL_CONSOLE=y

# Volcengine V1 speech replay defaults. Keep the API Key only in local sdkconfig.
CONFIG_TUCO_VOLCENGINE_ENABLED=y
CONFIG_TUCO_VOLCENGINE_ASR_WS_URL="wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async"
CONFIG_TUCO_VOLCENGINE_ASR_RESOURCE_ID="volc.seedasr.sauc.duration"
CONFIG_TUCO_VOLCENGINE_TTS_WS_URL="wss://openspeech.bytedance.com/api/v3/tts/bidirection"
CONFIG_TUCO_VOLCENGINE_TTS_RESOURCE_ID="seed-tts-2.0"
CONFIG_TUCO_VOLCENGINE_TTS_VOICE="zh_female_vv_uranus_bigtts"
# Keep mbedTLS protocol buffers in PSRAM and allocate them only while needed;
# internal DMA-capable RAM remains available for the ESP32-P4 AES engine.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Keep fixed TLS buffers for compatibility with the WebSocket transport;
# the buffers themselves are allocated from PSRAM by the external allocator.
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is intentionally left unset.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_WS_BUFFER_SIZE=4096
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=1000
